# Anthropic API Key - required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Model overrides (optional - defaults shown)
# Available: claude-haiku-4-5-20251001, claude-sonnet-4-6, claude-opus-4-6
LLM_MODEL_SCHOOLS=claude-haiku-4-5-20251001
LLM_MODEL_STRENGTHEN=claude-sonnet-4-6
LLM_MODEL_ESSAY=claude-sonnet-4-6
